import { useState } from "react"; 
import { useLoaderData, useFetcher } from "@remix-run/react"; 
import { authenticate } from "../shopify.server"; 
import { 
 Page, Layout, Card, BlockStack, Text, 
 Select, Button, Badge 
} from "@shopify/polaris"; 
import { json } from "@remix-run/node"; 
 
export const loader = async ({ request }) => { 
const { admin } = await authenticate.admin(request); 
 const response = await admin.graphql(` 
   query { 
     products(first: 20) { 
       edges { 
         node { 
           id title handle 
           description 
           priceRangeV2 { 
             minVariantPrice { amount currencyCode } 
           } 
           images(first: 1) { 
             edges { node { url } } 
           } 
         } 
       } 
     } 
   } 
 `); 
 const data = await response.json(); 
 return json({ products: data.data.products.edges.map(e => e.node) }); 
}; 
 
export default function StructuredData() { 
 const { products } = useLoaderData(); 
 const [selected, setSelected] = useState(products[0]?.id); 
 
 const product = products.find(p => p.id === selected); 
 
 const jsonLD = product ? JSON.stringify({ 
   "@context": "https://schema.org/", 
   "@type": "Product", 
   "name": product.title, 
   "description": product.description, 
   "image": product.images.edges[0]?.node.url, 
   "url": `https://yourstore.com/products/${product.handle}`, 
   "offers": { 
     "@type": "Offer", 
     "price": product.priceRangeV2.minVariantPrice.amount, 
     "priceCurrency": product.priceRangeV2.minVariantPrice.currencyCode, 
     "availability": "https://schema.org/InStock" 
   } 
 }, null, 2) : ""; 
 
 const copyScript = () => { 
   const script = `<script type="application/ld+json">\n${jsonLD}\n</script>`; 
   navigator.clipboard.writeText(script); 
 }; 
 
 return ( 
   <Page title="JSON-LD Structured Data"> 
     <Layout> 
       <Layout.Section> 
         <Card> 
           <BlockStack gap="400"> 
             <Text variant="headingMd">Generate Product Schema Markup</Text> 
             <Select 
               label="Select Product" 
               options={products.map(p => ({ label: p.title, value: p.id }))} 
               onChange={setSelected} 
               value={selected} 
             /> 
             <Badge tone="success">✅ Schema.org Product Type</Badge> 
             <div style={{ background: "#1e1e1e", padding: "16px", borderRadius: "8px" }}> 
               <pre style={{ color: "#d4d4d4", fontSize: "12px", margin: 0, overflow: "auto" }}> 
                 {jsonLD} 
               </pre> 
             </div> 
             <Button variant="primary" onClick={copyScript}> 
               📋 Copy Script Tag 
             </Button> 
             <Text tone="subdued"> 
               Paste this inside your theme's {"<head>"} tag or use a Script Tag API to inject it automatically. 
             </Text> 
           </BlockStack> 
         </Card> 
       </Layout.Section> 
     </Layout> 
   </Page> 
 ); 
} 
 
