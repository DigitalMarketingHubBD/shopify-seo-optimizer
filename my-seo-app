import { useState } from "react"; 
import { useLoaderData } from "@remix-run/react"; 
import { authenticate } from "../shopify.server"; 
import { 
 Page, Layout, Card, BlockStack, Text, 
 

 

 TextField, Button, DataTable, Select 
} from "@shopify/polaris"; 
import { json } from "@remix-run/node"; 
 
export const loader = async ({ request }) => { 
 const { admin } = await authenticate.admin(request); 
 const response = await admin.graphql(` 
   query { 
     products(first: 20) { 
       edges { 
         node { id title description bodyHtml } 
       } 
     } 
   } 
 `); 
 const data = await response.json(); 
 return json({ products: data.data.products.edges.map(e => e.node) }); 
}; 
 
function analyzeKeywords(text) { 
 if (!text) return []; 
 const clean = text.replace(/<[^>]+>/g, "").toLowerCase(); 
 const words = clean.match(/\b[a-z]{3,}\b/g) || []; 
 const freq = {}; 
 words.forEach(w => { freq[w] = (freq[w] || 0) + 1; }); 
 return Object.entries(freq) 
   .sort((a, b) => b[1] - a[1]) 
   .slice(0, 20) 
   .map(([word, count]) => ({ 
     word, 
     count, 
     density: ((count / words.length) * 100).toFixed(2) + "%" 
   })); 
} 
 
export default function Keywords() { 
 const { products } = useLoaderData(); 
 const [selected, setSelected] = useState(products[0]?.id); 
 const [targetKeyword, setTargetKeyword] = useState(""); 
 
 const product = products.find(p => p.id === selected); 
 const keywords = analyzeKeywords(product?.bodyHtml || product?.description); 
 
 const targetCount = keywords.find(k => k.word === targetKeyword.toLowerCase()); 
 
 const rows = keywords.map(k => [ 
   k.word, 
   k.count.toString(), 
   k.density, 
   k.word === targetKeyword.toLowerCase() 
     ? <Text tone="success">🎯 Target</Text> 
     : "" 
 ]); 
 
 return ( 
   <Page title="Keyword Density Checker"> 
     <Layout> 
       <Layout.Section> 
         <Card> 
           <BlockStack gap="400"> 
             <Select 
               label="Select Product" 
               options={products.map(p => ({ label: p.title, value: p.id }))} 
               onChange={setSelected} 
               value={selected} 
             /> 
             <TextField 
               label="Target Keyword" 
               value={targetKeyword} 
               onChange={setTargetKeyword} 
               placeholder="e.g. running shoes" 
               helpText="Check how often your target keyword appears" 
             /> 
             {targetKeyword && ( 
               <Text tone={targetCount ? "success" : "critical"}> 
                 {targetCount 
                   ? `✅ "${targetKeyword}" appears ${targetCount.count} times (${targetCount.density})` 
                   : `❌ "${targetKeyword}" not found in product description`} 
               </Text> 
             )} 
             {rows.length > 0 && ( 
               <DataTable 
                 columnContentTypes={["text", "numeric", "text", "text"]} 
                 headings={["Keyword", "Count", "Density", "Target"]} 
                 rows={rows} 
               /> 
             )} 
           </BlockStack> 
         </Card> 
       </Layout.Section> 
     </Layout> 
   </Page> 
 ); 
